{
    "name": "fullsmack/laravel-slice",
    "description": "A simple modules or slice package for Laravel",
    "homepage": "https://github.com/fullsmack/laravel-slice",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "nicolaibaaring"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0|^12.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpstan/phpstan": "^2.1"
    },
    "suggest": {
        "nunomaduro/collision": "Required for the slice:test command (installed by default in new Laravel applications)."
    },
    "autoload": {
        "psr-4": {
            "FullSmack\\LaravelSlice\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FullSmack\\LaravelSlice\\Test\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testdox",
        "test-coverage": "phpunit --coverage-html coverage",
        "test-filter": "phpunit --filter",
        "phpstan": "vendor/bin/phpstan analyse"

    },
    "extra": {
        "laravel": {
            "providers": [
                "FullSmack\\LaravelSlice\\LaravelSliceServiceProvider"
            ]
        }
    }
}
